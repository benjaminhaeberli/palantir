---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// ---- Probability math (mirrors tools/probabilites.py) ----------------------

type Mode = 'normal' | 'advantage' | 'disadvantage';

/** Le dé du destin réussit sur ses trois faces les plus hautes. */
const FATE_THRESHOLD = 10;

const d12Distribution = (mode: Mode): Map<number, number> => {
  const dist = new Map<number, number>();
  if (mode === 'normal') {
    for (let v = 1; v <= 12; v++) dist.set(v, 1 / 12);
    return dist;
  }
  for (let a = 1; a <= 12; a++) {
    for (let b = 1; b <= 12; b++) {
      const v = mode === 'advantage' ? Math.max(a, b) : Math.min(a, b);
      dist.set(v, (dist.get(v) ?? 0) + 1 / 144);
    }
  }
  return dist;
};

const nd6Distribution = (n: number): Map<number, number> => {
  if (n <= 0) return new Map([[0, 1]]);
  const dist = new Map<number, number>();
  const total = 6 ** n;
  const enumerate = (depth: number, sum: number) => {
    if (depth === 0) {
      dist.set(sum, (dist.get(sum) ?? 0) + 1 / total);
      return;
    }
    for (let v = 1; v <= 6; v++) enumerate(depth - 1, sum + v);
  };
  enumerate(n, 0);
  return dist;
};

interface Outcome {
  critFail: number;
  fail: number;        // includes crit fail
  success: number;     // includes crit success
  critSuccess: number;
  normalFail: number;
  normalSuccess: number;
}

/**
 * Système actuel : le dé du destin réussit sur 10-11-12, ou n'importe quel
 * dé de bravoure affichant un 6. Rien ne s'additionne.
 */
const analyze = (attribute: number, mode: Mode = 'normal', bonusDice = 0): Outcome => {
  const pool = Math.max(0, attribute + bonusDice);
  const noSix = (5 / 6) ** pool;
  const anySix = 1 - noSix;

  let critSuccess = 0;
  let critFail = 0;
  let success = 0;
  let fail = 0;

  for (const [v, p] of d12Distribution(mode)) {
    if (v === 12) {
      critSuccess += p;
      success += p;
    } else if (v === 1) {
      // Aucun 6 ne rattrape un échec critique.
      critFail += p;
      fail += p;
    } else if (v >= FATE_THRESHOLD) {
      success += p;
    } else {
      success += p * anySix;
      fail += p * noSix;
    }
  }

  return {
    critFail,
    fail,
    success,
    critSuccess,
    normalFail: fail - critFail,
    normalSuccess: success - critSuccess,
  };
};

/** Ancien système additif (1d12 + Nd6 ≥ SR), conservé pour comparaison. */
const analyzeLegacy = (attribute: number, mode: Mode = 'normal'): Outcome & { sr: number } => {
  const sr = 10 + 2 * attribute;
  const d12 = d12Distribution(mode);
  const d6s = nd6Distribution(attribute);

  let critSuccess = 0;
  let critFail = 0;
  let success = 0;
  let fail = 0;

  for (const [d12Val, p12] of d12) {
    for (const [sumD6, p6] of d6s) {
      const joint = p12 * p6;
      if (d12Val === 12) { critSuccess += joint; success += joint; }
      else if (d12Val === 1) { critFail += joint; fail += joint; }
      else if (d12Val + sumD6 >= sr) success += joint;
      else fail += joint;
    }
  }

  return {
    sr,
    critFail,
    fail,
    success,
    critSuccess,
    normalFail: fail - critFail,
    normalSuccess: success - critSuccess,
  };
};

const pct = (v: number) => `${(v * 100).toFixed(2)} %`;

// Pre-computed tables for the static section
const modes: Mode[] = ['normal', 'advantage', 'disadvantage'];
const modeLabel: Record<Mode, string> = {
  normal: 'Normal',
  advantage: 'Avantage',
  disadvantage: 'Désavantage',
};
const attributeRange = [0, 1, 2, 3, 4, 5, 6];

const tables = modes.map(mode => ({
  mode,
  rows: attributeRange.map(attr => ({ attr, ...analyze(attr, mode) })),
}));

// Ancien système vs nouveau, en mode normal.
const comparisonRows = attributeRange.map(attr => {
  const legacy = analyzeLegacy(attr);
  const current = analyze(attr);
  return {
    attr,
    sr: legacy.sr,
    legacy: legacy.success,
    current: current.success,
    delta: (current.success - legacy.success) * 100,
  };
});

// Ce que rapporte chaque PB dépensé (1 PB = 1 dé de bravoure de plus).
const forceDestinRows = [2, 4, 6].map(attr => ({
  attr,
  steps: [0, 1, 2, 3, 4, 5].map(spent => analyze(attr, 'normal', spent).success),
}));

// Échec critique en défense : l'ancienne règle enchaînait un jet de blessure (CON),
// l'actuelle rend Blessé sur-le-champ.
const defenseRows = [0, 1, 2, 3].map(con => {
  const blessure = analyze(con);
  const critFailP = 1 / 12;
  return {
    con,
    failBlessure: blessure.fail,
    blesseLegacy: critFailP * blessure.fail,
    blesseCurrent: critFailP,
    ratio: 1 / blessure.fail,
  };
});
---

<BaseLayout title="Probabilités du système">
  <div class="app app--book">
    <aside class="app__sidebar">
      <nav aria-label="Navigation outils">
        <div class="sidebar-group">
          <h2 class="sidebar-group__title">Outils</h2>
          <ul class="sidebar-list">
            <li><a href={`${base}#outils-divers`}>← Retour au livre</a></li>
            <li><a href={`${base}/outils/probabilites`} class="is-active">Probabilités</a></li>
          </ul>
        </div>
      </nav>
    </aside>

    <main class="app__main">
      <article class="chapter" id="probabilites">
        <h1 class="chapter__title">Probabilités du système</h1>
        <p class="page-meta">Calculateur exact pour le jet d'attribut sans addition.</p>

        <p>
          <strong>Rappel.</strong> Un jet d'attribut lance 1d12 (<em>dé du destin</em>) et autant de d6
          (<em>dés de bravoure</em>) que la valeur de l'attribut. Il est réussi si le <em>dé du destin</em>
          tombe sur l'une de ses <strong>trois faces les plus hautes</strong> (10, 11 ou 12),
          <strong>ou</strong> si au moins un <em>dé de bravoure</em> affiche un <strong>6</strong>.
          Rien ne s'additionne. Un 12 est une réussite critique, un 1 un échec critique qu'aucun 6 ne rattrape.
        </p>

        <h2>Tableaux de référence</h2>

        {tables.map(t => (
          <>
            <h3>Mode : {modeLabel[t.mode]}</h3>
            <table class="probs">
              <thead>
                <tr>
                  <th>Attribut</th>
                  <th>Crit ✗</th>
                  <th>Échec</th>
                  <th>Réussite</th>
                  <th>Crit ✓</th>
                  <th>Total ✓</th>
                </tr>
              </thead>
              <tbody>
                {t.rows.map(r => (
                  <tr>
                    <td>{r.attr}</td>
                    <td>{pct(r.critFail)}</td>
                    <td>{pct(r.normalFail)}</td>
                    <td>{pct(r.normalSuccess)}</td>
                    <td>{pct(r.critSuccess)}</td>
                    <td><strong>{pct(r.success)}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        ))}

        <h2>Ce que la refonte a changé</h2>
        <p>
          L'ancien système additionnait <code>1d12 + Nd6</code> et comparait le total à un
          <em>seuil de réussite</em> valant <code>10 + 2 × attribut</code>. La courbe est
          volontairement restée très proche, pour que le bestiaire, les dégâts et l'Endurance
          n'aient pas à être recalibrés.
        </p>
        <table class="probs">
          <thead>
            <tr>
              <th>Attribut</th>
              <th>Ancien SR</th>
              <th>Ancien système</th>
              <th>Système actuel</th>
              <th>Écart</th>
            </tr>
          </thead>
          <tbody>
            {comparisonRows.map(r => (
              <tr>
                <td>{r.attr}</td>
                <td>{r.sr}</td>
                <td>{pct(r.legacy)}</td>
                <td><strong>{pct(r.current)}</strong></td>
                <td>{r.delta >= 0 ? '+' : ''}{r.delta.toFixed(1)} pts</td>
              </tr>
            ))}
          </tbody>
        </table>

        <h2>Forcer le destin — ce que rapporte chaque PB</h2>
        <p>
          Dépenser 1 <em>point de Bravoure</em> ajoute un <em>dé de bravoure</em> au jet, sans limite.
          Chaque dé pèse un peu moins que le précédent : on améliore ses chances sans jamais
          acheter la certitude, ce qui rend la dépense sûre à tout niveau.
        </p>
        <table class="probs">
          <thead>
            <tr>
              <th>Attribut</th>
              <th>0 PB</th>
              <th>1 PB</th>
              <th>2 PB</th>
              <th>3 PB</th>
              <th>4 PB</th>
              <th>5 PB</th>
            </tr>
          </thead>
          <tbody>
            {forceDestinRows.map(r => (
              <tr>
                <td>{r.attr}</td>
                {r.steps.map(v => <td>{pct(v)}</td>)}
              </tr>
            ))}
          </tbody>
        </table>

        <h2>Échec critique en défense — pourquoi Blessé direct</h2>
        <p>
          Sur un <em>échec critique</em> en défense, le héros devient <em>Blessé</em> sur-le-champ, sans
          repasser par un jet de blessure (CON). Le jet de blessure ne sert plus qu'aux périls hors
          combat (chute, feu, poison…). Voici ce que la bascule a changé :
        </p>
        <table class="probs">
          <thead>
            <tr>
              <th>CON</th>
              <th>P(rater jet blessure)</th>
              <th>P(Blessé) <strong>ancienne</strong></th>
              <th>P(Blessé) <strong>actuelle</strong></th>
              <th>×</th>
            </tr>
          </thead>
          <tbody>
            {defenseRows.map(r => (
              <tr>
                <td>{r.con}</td>
                <td>{pct(r.failBlessure)}</td>
                <td>{pct(r.blesseLegacy)}</td>
                <td>{pct(r.blesseCurrent)}</td>
                <td>{r.ratio.toFixed(2)}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <h2>Calculateur libre</h2>
        <p>
          Les <em>dés en plus</em> couvrent tout ce qui modifie un jet sans passer par le dé du destin :
          outil adapté, aide d'un compagnon, PB dépensés pour <em>Forcer le destin</em>. Une valeur
          négative représente des conditions défavorables.
        </p>

        <form class="prob-form" id="prob-form">
          <label>
            <span>Attribut (nombre de d6)</span>
            <input type="number" id="prob-attr" value="2" min="0" max="10" />
          </label>
          <label>
            <span>Dés en plus (outil, aide, PB dépensés)</span>
            <input type="number" id="prob-bonus" value="0" min="-6" max="10" />
          </label>
          <label>
            <span>Mode</span>
            <select id="prob-mode">
              <option value="normal">Normal</option>
              <option value="advantage">Avantage</option>
              <option value="disadvantage">Désavantage</option>
            </select>
          </label>
        </form>

        <div id="prob-result" class="prob-result" aria-live="polite"></div>

        <h2>Notes de design</h2>
        <ul>
          <li>
            <strong>Aucune addition.</strong> On lit le dé du destin, et s'il ne suffit pas on cherche
            un 6. C'était le motif de la refonte : l'ancien système faisait additionner jusqu'à sept dés
            à haut niveau.
          </li>
          <li>
            <strong>Le MJ n'annonce jamais de nombre.</strong> Le seuil du dé du destin est une constante
            du jeu ; la difficulté se règle en ajoutant ou retirant des <em>dés de bravoure</em>.
          </li>
          <li>
            <strong>Attribut 0</strong> ≈ 25 % — le destin laisse toujours sa chance sur quatre, même
            à un parfait novice. Aucune accumulation de malus ne peut descendre sous ce plancher :
            seul le <em>désavantage</em>, qui frappe le dé du destin lui-même, le fait tomber à 6,25 %.
          </li>
          <li>
            <strong>Crits</strong> ≈ 8,33 % chacun (1/12), <strong>à tous les niveaux</strong>. C'est
            volontaire : l'échec critique ignore l'armure, brise les boucliers et blesse sur-le-champ.
            Un système qui l'érode en montant en niveau désamorcerait la létalité du jeu.
          </li>
          <li>
            <strong>Avantage et désavantage</strong> (deux dés du destin, on garde le meilleur ou le pire)
            sont bien plus forts qu'un dé de bravoure : l'avantage fait passer l'attribut 2 de 45 % à 61 %
            et divise l'échec critique par douze. D'où leur réserve aux <em>États</em>, aux objets
            remarquables et aux sortilèges.
          </li>
          <li>
            <strong>Blessé direct en défense.</strong> La règle est plus simple et plus tendue, mais
            double quasi le taux de blessures sur défense ratée à CON 2+. C'est assumé : elle récompense
            la <em>parade avec bouclier</em> — l'avantage divise l'échec critique par douze — et
            l'évitement quand on est déjà blessé, puisqu'une seconde blessure fait tomber
            <em>Inconscient</em>.
          </li>
          <li>
            <strong>Réussite critique en défense.</strong> Le 12 ouvre une contre-attaque gratuite, soit
            ≈ 8,33 % des défenses. Comme le MJ ne lance jamais de dés, chaque attaque adverse est un jet
            de joueur : sur un combat, cette symétrie rend le 1 et le 12 aussi fréquents l'un que l'autre.
          </li>
        </ul>
      </article>
    </main>
  </div>
</BaseLayout>

<style>
  table.probs th, table.probs td { font-variant-numeric: tabular-nums; }
  .prob-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin: 1rem 0 1.5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .prob-form label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.95em; }
  .prob-form input,
  .prob-form select {
    padding: 0.5em 0.7em;
    border: 1px solid var(--color-border-strong);
    background: white;
    font-family: var(--font-body);
    font-size: 1em;
  }
  .prob-result {
    margin-bottom: 2em;
  }
  .prob-result table {
    margin: 0;
  }
</style>

<script>
  // Mirror of the analyze() function above, in plain JS for client-side use.
  const FATE_THRESHOLD = 10;

  const d12Dist = (mode) => {
    const m = new Map();
    if (mode === 'normal') {
      for (let v = 1; v <= 12; v++) m.set(v, 1 / 12);
      return m;
    }
    for (let a = 1; a <= 12; a++) for (let b = 1; b <= 12; b++) {
      const v = mode === 'advantage' ? Math.max(a, b) : Math.min(a, b);
      m.set(v, (m.get(v) ?? 0) + 1 / 144);
    }
    return m;
  };

  const analyze = (attribute, mode, bonusDice) => {
    const pool = Math.max(0, attribute + bonusDice);
    const noSix = (5 / 6) ** pool;
    const anySix = 1 - noSix;
    let cs = 0, cf = 0, s = 0, f = 0;
    for (const [v, p] of d12Dist(mode)) {
      if (v === 12) { cs += p; s += p; }
      else if (v === 1) { cf += p; f += p; }
      else if (v >= FATE_THRESHOLD) { s += p; }
      else { s += p * anySix; f += p * noSix; }
    }
    return { pool, critFail: cf, fail: f, success: s, critSuccess: cs };
  };

  const pct = (v) => `${(v * 100).toFixed(2)} %`;

  const render = () => {
    const attr = Math.max(0, Math.min(10, Number(document.getElementById('prob-attr').value) || 0));
    const bonus = Math.max(-6, Math.min(10, Number(document.getElementById('prob-bonus').value) || 0));
    const mode = document.getElementById('prob-mode').value;
    const r = analyze(attr, mode, bonus);
    document.getElementById('prob-result').innerHTML = `
      <table class="probs">
        <thead>
          <tr>
            <th>Dés lancés</th>
            <th>Crit ✗</th>
            <th>Échec</th>
            <th>Réussite</th>
            <th>Crit ✓</th>
            <th>Total ✓</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>1d12 + ${r.pool}d6</td>
            <td>${pct(r.critFail)}</td>
            <td>${pct(r.fail - r.critFail)}</td>
            <td>${pct(r.success - r.critSuccess)}</td>
            <td>${pct(r.critSuccess)}</td>
            <td><strong>${pct(r.success)}</strong></td>
          </tr>
        </tbody>
      </table>
    `;
  };

  const setup = () => {
    document.getElementById('prob-form').addEventListener('input', render);
    render();
  };
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
  else setup();
</script>
